# Application
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000
CORS_ALLOWED_ORIGIN=*

# Logging & Cache (relative to backend/ or absolute path outside public/)
LOG_PATH=storage/logs
LOG_MAX_FILES=30
POI_CACHE_TTL_SECONDS=300
OG_DEFAULT_IMAGE_URL=https://gta6map.com.br/assets/og-leonida.webp

# MySQL 8.0+ (InnoDB / PDO_MYSQL)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=gta6map
DB_USER=root
DB_PASS=

# Auth & External Integrations (Phase 2+)
JWT_SECRET=change_me_use_64_char_random_hex
JWT_TTL_SECONDS=604800
GOOGLE_CLIENT_ID=
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=
