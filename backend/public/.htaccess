Options -Indexes

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Block access to hidden dotfiles (.env, .htaccess, .git) and sensitive extensions
<FilesMatch "(^\.|\.(env|log|neon|xml|lock|sql|sh|bak)$)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Preserve Authorization and X-Request-ID headers on shared hosting CGI/FastCGI
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Block direct traversal to internal directories if exposed
    RewriteRule ^(?:src|storage|vendor|bin|tests|database)(?:/|$) - [F,L,NC]

    # Route /api/* explicitly to front controller
    RewriteRule ^api(?:/.*)?$ index.php [QSA,L]

    # Route non-file/non-directory requests to index.php
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.php [QSA,L]
</IfModule>
